# Storyteller local dev defaults for /compose.yaml.
# Copy to .env (never commit). Most values match the docker-compose stack
# in this repo; override locally as needed.

# Project / network
COMPOSE_PROJECT_NAME=storyteller
PUBLIC_HOST=storyteller.test
PUBLIC_HTTPS=false

# Postgres (pgvector)
POSTGRES_DB=storyteller
POSTGRES_USER=storyteller
POSTGRES_PASSWORD=storyteller
# Host-side port. Moved from 5432 (default) to 5433 to free the standard
# port on the operator's host machine â€” phalcon5-projects-postgres-1 was
# holding 5432 and we want both stacks usable side by side.
# Container-internal still listens on 5432 â€” no API code change needed.
POSTGRES_PORT=5433
POSTGRES_TEST_DB=storyteller_test

# Redis
REDIS_PASSWORD=CHANGE_ME_FOR_PRODUCTION
# Host-side port. Moved from 6379 (default) to 6380 to avoid the conflict
# with phalcon5_docker's redis-stack-server which binds 6379 on the host.
# Container-internal still listens on 6379 â every other storyteller
# service connects via the docker DNS name "redis" + 6379, no API code
# change needed. On a dedicated host, set REDIS_PORT=6379.
REDIS_PORT=6380

# R18f: phpredis extension is not installed in the api container,
# so any code path that uses the Redis cache store (CircuitBreakerState,
# ProviderRouter, queue) crashes with "Class Redis not found". Fall
# back to file cache for the runtime; session/queue stay on database
# in dev so the smoke test can complete. Tracked as P2-debt in
# r18f-load-investigation.md.
REDIS_CLIENT=phpredis
CACHE_STORE=file
SESSION_DRIVER=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# MinIO (object storage)
MINIO_ROOT_USER=storyteller
MINIO_ROOT_PASSWORD=CHANGE_ME_FOR_PRODUCTION
MINIO_BUCKET=storyteller
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mailpit
MAILPIT_PORT=1025
MAILPIT_UI_PORT=8025

# Laravel API
APP_VERSION=0.0.0-stage-s0
APP_NAME="Storyteller API"
APP_KEY=CHANGE_ME_FOR_PRODUCTION
APP_DEBUG=true
# R18f B-4: flip to production so AiProductionServiceProvider binds
# ProviderRouter (LM Studio + OpenAI). Default in image is empty
# (development mode = FakeNarrationServiceProvider).
APP_AI_MODE=production

# AI provider (Stage S3) â€” LM Studio on the operator's host, routed via
# the docker bridge. The 172.31.240.1 IP is the user's Tailscale/LAN
# address; from inside the api container it reaches the host network
# through docker-desktop's NAT. If the api container can't reach this
# IP, set LMSTUDIO_BASE_URL=http://172.21.192.1:1234/v1
# (the default the api repo's AiProviderSeeder writes).
AI_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://172.21.192.1:1234/v1
LMSTUDIO_MODEL=qwen/qwen3-vl-4b
LMSTUDIO_MAX_TOKENS=1024
# R18f B-2.1: pin sampler seed for byte-deterministic completions.
LMSTUDIO_SEED=0
# qwen/qwen3-vl-4b is a vision-language model â€” text-only inference
# against LM Studio takes 30-90 s for the full ContextManifest prompt.
# 120 s gives the model room to finish without false-positive 502s.
LMSTUDIO_TIMEOUT_SECONDS=120

# Laravel Reverb
REVERB_APP_ID=storyteller-app
REVERB_APP_KEY=CHANGE_ME_FOR_PRODUCTION
REVERB_APP_SECRET=storyteller-secret

# Caddy gateway
CADDY_HTTP_PORT=8088
CADDY_HTTPS_PORT=4443
